[debug] [2026-10-05T04:18:05.123Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/stellar-cumulus-108603/rulesets {"name":"projects/stellar-cumulus-108603/rulesets/3201f9ef-232a-4787-a41e-ec57d964b80e","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    function signedIn() {\n      return request.auth != null;\n    }\n\n    function isAdmin() {\n      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));\n    }\n\n    function validProvider(data) {\n      return data.keys().hasOnly(['name', 'phone', 'category', 'type', 'location', 'imageUrl',\n                                  'address', 'description', 'createdAt', 'createdBy'])\n        && data.keys().hasAll(['name', 'phone', 'category', 'type', 'location'])\n        && data.name is string && data.name.size() > 0 && data.name.size() <= 100\n        && data.phone is string && data.phone.size() <= 30\n        && data.category in ['household', 'lifestyle', 'groceries', 'food']\n        && data.type is string && data.type.size() > 0 && data.type.size() <= 40\n        && data.location is latlng\n        && (!('imageUrl' in data) || (data.imageUrl is string\n              && (data.imageUrl == '' || data.imageUrl.matches('^https://.*'))))\n        && (!('address' in data) || (data.address is string && data.address.size() <= 300))\n        && (!('description' in data) || (data.description is string && data.description.size() <= 2000));\n    }\n\n    match /providers/{providerId} {\n      allow read: if signedIn();\n      allow create: if signedIn()\n        && request.resource.data.createdBy == request.auth.uid\n        && validProvider(request.resource.data);\n      allow update: if (isAdmin() || resource.data.createdBy == request.auth.uid)\n        && request.resource.data.createdBy == resource.data.createdBy\n        && validProvider(request.resource.data);\n      allow delete: if isAdmin() || (signedIn() && resource.data.createdBy == request.auth.uid);\n    }\n\n    // Write-only for users; reviewed by admins via the Firebase console or tools/admin.\n    match /reports/{reportId} {\n      allow create: if signedIn()\n        && request.resource.data.keys().hasOnly(['providerId', 'reason', 'reportedBy', 'createdAt'])\n        && request.resource.data.reportedBy == request.auth.uid\n        && request.resource.data.providerId is string\n        && request.resource.data.reason is string && request.resource.data.reason.size() <= 500;\n      allow read, update, delete: if isAdmin();\n    }\n\n    match /users/{uid} {\n      allow read, delete: if signedIn() && request.auth.uid == uid;\n      allow create, update: if signedIn() && request.auth.uid == uid\n        && request.resource.data.keys().hasOnly(['name', 'email', 'place', 'photo', 'createdAt', 'updatedAt'])\n        && (!('photo' in request.resource.data)\n              || (request.resource.data.photo is bytes && request.resource.data.photo.size() <= 300000));\n    }\n\n    // Managed only through tools/admin (Admin SDK bypasses rules).\n    match /admins/{uid} {\n      allow read: if signedIn() && request.auth.uid == uid;\n      allow write: if false;\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-10-05T04:18:05.126015Z","metadata":{"services":["cloud.firestore"]}}
